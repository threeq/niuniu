{
  "id": "xiaohongshu",
  "version": 1,
  "status": "published",
  "display_name": "小红书",
  "capabilities": ["publish", "metrics", "engagements", "reply"],
  "bindings": {
    "publish": { "transport": "browser", "recipe": "browser/recipes/publish.json" },
    "metrics": { "transport": "browser", "recipe": "browser/recipes/metrics.json" },
    "engagements": { "transport": "browser", "recipe": "browser/recipes/engagements.json" },
    "reply": { "transport": "browser", "recipe": "browser/recipes/reply.json" }
  },
  "credential_slots": {
    "account": { "required": true, "scope": "account" }
  },
  "allowed_hosts": [
    "creator.xiaohongshu.com",
    "www.xiaohongshu.com",
    "xiaohongshu.com"
  ],
  "content_schema": {
    "formats": {
      "note": {
        "fields": ["title", "body", "images", "tags", "cover"],
        "max_chars": 1000,
        "max_title_chars": 20,
        "image_ratio": "3:4",
        "max_images": 18,
        "video_sec": 0
      },
      "video": {
        "fields": ["title", "body", "video", "cover", "tags"],
        "max_chars": 1000,
        "max_title_chars": 20,
        "image_ratio": "3:4",
        "max_images": 1,
        "video_sec": 900
      }
    }
  },
  "compliance": {
    "forbidden_terms": [
      "最佳", "最好", "最强", "最优", "第一", "首选", "唯一", "顶级",
      "国家级", "世界级", "100%", "万能", "永久", "纯天然", "零风险",
      "包治百病", "药到病除", "无副作用", "稳赚不赔", "全网最低", "限时秒杀",
      "私信我领", "加微信"
    ],
    "required_checks": [
      "遵守小红书社区规范，不得发布虚假种草或未体验测评",
      "医疗、美容、功效类内容不得作出功效承诺或疗效宣称",
      "不得出现站外导流（微信/QQ/电话/二维码/外链）",
      "图片与视频须原创或已获授权，二创须注明来源",
      "不得使用极限词、绝对化用语或虚假促销信息",
      "商业推广须按平台要求报备并标注合作"
    ]
  },
  "metrics_map": {
    "fields": {
      "view_num": "views",
      "like_num": "likes",
      "collect_num": "saves",
      "comment_num": "comments",
      "share_num": "shares",
      "fans_add": "follower_delta"
    }
  }
}
