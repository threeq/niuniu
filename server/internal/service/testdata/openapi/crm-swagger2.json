{
  "swagger": "2.0",
  "info": { "title": "Acme CRM", "version": "2.1" },
  "host": "crm.acme.example:8443",
  "basePath": "/api/v2",
  "schemes": ["https"],
  "securityDefinitions": {
    "apiKeyHeader": { "type": "apiKey", "in": "header", "name": "X-API-Key" }
  },
  "paths": {
    "/contacts": {
      "get": {
        "operationId": "listContacts",
        "summary": "List contacts",
        "tags": ["contacts"],
        "parameters": [
          { "name": "page", "in": "query", "type": "integer" },
          { "name": "page_size", "in": "query", "type": "integer" }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "type": "object",
              "properties": {
                "items": { "type": "array", "items": { "$ref": "#/definitions/Contact" } },
                "total": { "type": "integer" }
              }
            }
          }
        }
      }
    },
    "/contacts/{id}": {
      "get": {
        "operationId": "getContact",
        "summary": "Get one contact",
        "tags": ["contacts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "ok", "schema": { "$ref": "#/definitions/Contact" } }
        }
      }
    },
    "/contacts/{id}/notes": {
      "post": {
        "operationId": "addNote",
        "summary": "Add a note",
        "tags": ["contacts", "notes"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          { "name": "body", "in": "body", "schema": { "type": "object" } }
        ],
        "responses": { "201": { "description": "created" } }
      }
    }
  }
}
