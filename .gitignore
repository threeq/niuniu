### JetBrains template
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
.idea/
bin/
.claude/
.worktrees/
niuniu.exe
.playwright-mcp
web/test-results/
.superpowers/
.qoder/
.claude/
*.exe
.history/
desktop/internal/bundle/server-bin/*/niuniu-server
desktop/internal/bundle/server-bin/*/niuniu-server.exe
desktop/internal/bundle/server-bin/*/niuniu-mcp
desktop/internal/bundle/server-bin/*/niuniu-mcp.exe
# Generated by goversioninfo on Windows builds (embeds icon + VS_VERSION_INFO).
# Auto-linked by `go build` via the _windows_amd64.syso suffix; rebuilt on every
# Windows build, not source.
desktop/cmd/personal/resource_*.syso
# Relay runtime artifacts
relay/*.db
relay.db
# Real relay runtime config — holds SMTP / DB / JWT secrets. `config.example.yaml`
# stays tracked as a template; `relay.yaml` is local/deployment state only.
relay/relay.yaml
relay.yaml
# Per-agent role markdown dropped by harness / sub-agent tooling at runtime —
# generated locally per workspace, not source of truth, not committed.
server/internal/api/agents/*.md
# AES-GCM keyring for external integration credentials. Production resolves
# under cfg.DataDir (~/.niuniu/integration_secret); the testutil now pins
# DataDir to t.TempDir, but keep this guard for any future test that forgets.
integration_secret
server/**/integration_secret

# Team distribution build output (contains binaries + signing private key copy)
team-pkg/
node_modules/